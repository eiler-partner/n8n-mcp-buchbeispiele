# Ein Provider wird pro Prozess aktiviert. Modellnamen bleiben Konfiguration.
MODEL_PROVIDER=ollama

# Fuer CLI und Tests auf dem Mac. Compose liest diese Datei ebenfalls; der
# Container nutzt aber CONTAINER_OLLAMA_HOST (Standard: host.docker.internal).
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:14b

# Keine echten Schluessel in diese Datei oder in Git eintragen.
OPENAI_API_KEY=
OPENAI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Live-Tests sind ein bewusstes Kosten- und Datengate.
RUN_LIVE_MODEL_TESTS=0
