  ],
  "flows": [
    {"from": "requester", "to": "n8n", "contract": "Auftrag-ID und Zweck", "classification": "internal", "control": "Anmeldung und Zweckbindung", "approval": false},
    {"from": "n8n", "to": "document_store", "contract": "Dokument-ID zu Version", "classification": "confidential", "control": "Serviceidentitaet und Mandantenfilter", "approval": false},
    {"from": "n8n", "to": "retrieval", "contract": "Suchfrage zu Quellen-IDs und Zitaten", "classification": "confidential", "control": "Leserechte und Mandantenfilter", "approval": false},
    {"from": "n8n", "to": "model", "contract": "Redigierte Textstellen zu JSON-Entwurf", "classification": "internal", "control": "Datenminimierung und Providervertrag", "approval": false},
    {"from": "model", "to": "review", "contract": "JSON-Entwurf und Quellen-IDs", "classification": "internal", "control": "Schema- und Belegpruefung", "approval": false},
    {"from": "review", "to": "approver", "contract": "Pruefansicht zu Freigabeentscheidung", "classification": "internal", "control": "getrennte Freigabeidentitaet", "approval": false},
    {"from": "approver", "to": "review", "contract": "signierte Entscheidung zu Freigabe-ID", "classification": "internal", "control": "Vier-Augen-Prinzip und Identitaet", "approval": false},
    {"from": "review", "to": "publisher", "contract": "Freigabe-ID und gepruefter Entwurf", "classification": "internal", "control": "Freigabe-Token und Schreibrecht", "approval": true}
  ]
