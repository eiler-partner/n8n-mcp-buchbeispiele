    {"id": "retrieval", "role": "retriever", "zone": "internal", "owner": "Wissensteam", "input": "Suchfrage und Mandant", "output": "belegte Textstellen"},
    {"id": "model", "role": "model", "zone": "provider", "owner": "Modellbetreiber", "input": "minimierter Kontext", "output": "Entwurf mit Belegen"},
    {"id": "review", "role": "policy", "zone": "internal", "owner": "Compliance", "input": "Entwurf und Belege", "output": "gepruefter Entwurf"},
