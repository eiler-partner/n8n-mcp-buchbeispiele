MODEL_PROVIDER=ollama
# Fuer CLI und Tests auf dem Mac. Compose liest diese Datei ebenfalls; der
# Container nutzt aber CONTAINER_OLLAMA_HOST (Standard: host.docker.internal).
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:14b
OPENAI_API_KEY=
OPENAI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
AGENT_MAX_STEPS=4
AGENT_MAX_SECONDS=45
AGENT_MAX_RESULT_CHARS=8000
AGENT_AUDIT_PATH=./var/audit.jsonl
