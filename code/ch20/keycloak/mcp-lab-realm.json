{
  "realm": "mcp-lab",
  "enabled": true,
  "displayName": "MCP Chapter 20 Lab",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "rememberMe": false,
  "clients": [
    {
      "clientId": "mcp-book-client",
      "name": "MCP Book Client",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "consentRequired": true,
      "redirectUris": [
        "http://127.0.0.1:3000/callback",
        "http://localhost:6274/oauth/callback"
      ],
      "webOrigins": ["+"] ,
      "defaultClientScopes": [
        "basic",
        "documents:read"
      ],
      "protocolMappers": [
        {
          "name": "mcp-resource-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "http://127.0.0.1:8020/mcp",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        },
        {
          "name": "tenant-id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "tenant_id",
            "claim.name": "tenant_id",
            "jsonType.label": "String",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "userinfo.token.claim": "false"
          }
        },
        {
          "name": "consent-status",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "consent_status",
            "claim.value": "granted",
            "jsonType.label": "String",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        },
        {
          "name": "consent-id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "consent_id",
            "claim.value": "keycloak-browser-consent",
            "jsonType.label": "String",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
  "clientScopes": [
    {
      "name": "basic",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false"
      },
      "protocolMappers": []
    },
    {
      "name": "documents:read",
      "description": "Read document metadata through the MCP lab",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true",
        "consent.screen.text": "Dokumentmetadaten des eigenen Mandanten lesen"
      },
      "protocolMappers": []
    }
  ],
  "users": [
    {
      "username": "alice",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Alice",
      "lastName": "Tenant A",
      "attributes": {"tenant_id": ["tenant-a"]},
      "credentials": [
        {"type": "password", "value": "alice-local-only", "temporary": false}
      ]
    },
    {
      "username": "bob",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Bob",
      "lastName": "Tenant B",
      "attributes": {"tenant_id": ["tenant-b"]},
      "credentials": [
        {"type": "password", "value": "bob-local-only", "temporary": false}
      ]
    }
  ]
}
